+.v19-quick-tools{padding:13px 6px;display:flex;flex-direction:column;align-items:stretch;gap:8px;height:100%;background:#fff}
+.v19-quick-tools>strong{font-size:11px;color:#7c8794;text-align:center;margin-bottom:10px}
+.v19-quick-tools>button{display:flex;flex-direction:column;align-items:center;gap:2px;border:1px solid transparent;border-radius:9px;padding:9px 2px;background:transparent;color:#28558e;font-size:21px;cursor:pointer;line-height:1.2}
+.v19-quick-tools>button span{font-size:10px;color:#697e94}
+.v19-quick-tools>button:hover,.v19-quick-tools>button[aria-expanded=true]{background:#eaf2fd;border-color:#c7d9ee}
+.v19-structure-panel{position:absolute;z-index:15;top:0;bottom:0;left:78px;width:265px;max-height:100%;display:flex;flex-direction:column;background:#fff;border-right:1px solid #d9e3f0;box-shadow:6px 4px 28px #26385026}
+.v19-tree-body{display:flex;flex-direction:column;min-height:0;height:100%}
+.v19-simple-inspector h3{font-size:14px;margin:4px 0 1px}
+.v19-subtle{font-size:11px;color:#788a9e;margin:0 0 20px}
+.v19-simple-inspector .v6-property-field{margin-bottom:15px}
+.v19-connected{display:flex;justify-content:space-between;align-items:center;font-size:11px;color:#51708a}
+.v19-disclosure,.v19-more{border:0;border-radius:6px;background:#eff5fe;color:#315f9c;cursor:pointer;padding:9px 11px;text-align:left;font-size:12px;width:100%;margin-top:8px}
+.v19-more{background:transparent;border:1px solid #d9e3ef;color:#5a708c;margin-top:18px}
+.v19-compact-actions{position:relative;align-items:center}
+.v19-compact-actions>.v19-disclosure{width:38px;margin:0;text-align:center;padding:5px;background:#eef3f9}
+.v19-compact-actions>.v19-editing-menu{position:absolute;top:32px;right:0;z-index:25;width:max-content;max-width:min(430px,90vw);padding:10px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;background:#fff;border:1px solid #e1e7ef;border-radius:8px;box-shadow:0 9px 24px #162b4d29}
+.v19-compact-actions .v19-editing-menu .v17-group-controls{flex-wrap:wrap}
+.v19-simple-layout .v6-center-head span{display:none}
+.v19-simple-layout .v6-design-help{display:none}
