diff --git a/tests/editing-v015.test.js b/tests/editing-v015.test.js
new file mode 100644
index 0000000..f224be1
--- /dev/null
+++ b/tests/editing-v015.test.js
@@ -0,0 +1,76 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createDefaultRegistry,createEditorNode,insertEditorNode,duplicateEditorNode,editorSelectionPath,createComponentDefinition,exposeDefinitionSlot,insertSlotChild} from '../packages/core/index.js';
+import {editorShortcut} from '../packages/core/shortcuts.js';
+import {createSearchBoxDocument,findNode,serializeDocument,parseDocument,literal} from '../packages/schema/index.js';
+const r=createDefaultRegistry();
+const fresh=()=>createSearchBoxDocument();
+const ids=n=>[n.id,...(n.children||[]).flatMap(ids),...Object.values(n.slots||{}).flatMap(items=>items.flatMap(ids))];
+test('v0.15 duplicates a component adjacent to source with new ID and independent props',()=>{
+ const doc=fresh(),original=doc.pages.main.root.children[0];
+ const {document:copy,id}=duplicateEditorNode(doc,original.id,r);
+ assert.deepEqual(copy.pages.main.root.children.map(n=>n.id),[original.id,id,'customerSearch','productSearch']);
+ assert.notEqual(id,original.id);assert.equal(copy.pages.main.root.children[1].name,`${original.name||'Text'} Copy`);
+ copy.pages.main.root.children[1].props.text=literal('edited');
+ assert.notDeepEqual(copy.pages.main.root.children[1].props.text,copy.pages.main.root.children[0].props.text);
+ assert.equal(doc.pages.main.root.children.length,3);
+ assert.deepEqual(parseDocument(serializeDocument(copy,r),r),copy);
+});
+test('v0.15 duplicates a nested frame with recursively unique IDs and intact bindings',()=>{
+ let doc=fresh();const frame=createEditorNode(doc,'layout/row',r);
+ doc=insertEditorNode(doc,'pageRoot',3,frame,r);
+ const button=createEditorNode(doc,'core/Button',r);doc=insertEditorNode(doc,frame.id,0,button,r);
+ const childFrame=createEditorNode(doc,'layout/column',r);doc=insertEditorNode(doc,frame.id,1,childFrame,r);
+ const {document:copy,id}=duplicateEditorNode(doc,frame.id,r);
+ const source=findNode(copy.pages.main.root,frame.id),duplicate=findNode(copy.pages.main.root,id);
+ assert.equal(duplicate.children.length,2);
+ assert.equal(duplicate.children[0].typeId,'core/Button');
+ assert.equal(duplicate.children[1].layout.type,'column');
+ assert.equal(copy.pages.main.root.children.at(-1).id,id);
+ const all=ids(copy.pages.main.root);assert.equal(new Set(all).size,all.length);
+ assert.deepEqual(editorSelectionPath(copy.pages.main.root,duplicate.children[0].id).map(x=>x.id),['pageRoot',id,duplicate.children[0].id]);
+ assert.deepEqual(editorSelectionPath(copy.pages.main.root,'missing'),[]);
+ assert.equal(source.children[0].id,button.id);
+});
+test('v0.15 duplicates a filled slot and remaps nested nodes without changing its Definition',()=>{
+ let doc=fresh();doc=createComponentDefinition(doc,'Panel',r);
+ const frame=createEditorNode(doc,'layout/column',r);doc=insertEditorNode(doc,doc.definitions.Panel.root.id,0,frame,r,'definition:Panel');
+ doc=exposeDefinitionSlot(doc,'Panel',frame.id,'content',r);
+ const inst=createEditorNode(doc,'module/Panel',r);doc=insertEditorNode(doc,'pageRoot',0,inst,r);
+ const child=createEditorNode(doc,'layout/row',r);doc=insertSlotChild(doc,inst.id,'content',0,child,r);
+ const nested=createEditorNode(doc,'core/Text',r);doc=insertEditorNode(doc,child.id,0,nested,r);
+ const {document:copy,id}=duplicateEditorNode(doc,inst.id,r);
+ const orig=findNode(copy.pages.main.root,inst.id),dup=findNode(copy.pages.main.root,id);
+ assert.equal(dup.definitionId,'Panel');assert.equal(dup.slots.content[0].kind,'frame');
+ assert.notEqual(dup.slots.content[0].id,orig.slots.content[0].id);
+ assert.notEqual(dup.slots.content[0].children[0].id,orig.slots.content[0].children[0].id);
+ assert.deepEqual(editorSelectionPath(copy.pages.main.root,dup.slots.content[0].children[0].id).map(x=>x.id),['pageRoot',id,dup.slots.content[0].id,dup.slots.content[0].children[0].id]);
+ assert.deepEqual(copy.definitions.Panel,doc.definitions.Panel);
+});
+test('v0.15 works in Definition scope and never duplicates the root',()=>{
+ const doc=fresh(),def=doc.definitions.SearchBox;
+ const {document:copy,id}=duplicateEditorNode(doc,'searchButton',r,'definition:SearchBox');
+ assert.ok(findNode(copy.definitions.SearchBox.root,id));
+ assert.equal(copy.definitions.SearchBox.revision,def.revision+1);
+ assert.equal(copy.pages.main.root.children.length,doc.pages.main.root.children.length);
+ assert.throws(()=>duplicateEditorNode(doc,'pageRoot',r),/루트/);
+ assert.throws(()=>duplicateEditorNode(doc,'searchRoot',r,'definition:SearchBox'),/루트/);
+ assert.throws(()=>duplicateEditorNode(doc,'absent',r),/루트/);
+});
+test('v0.15 shortcut arbitration respects editors, modals and design-only operations',()=>{
+ const e=(key,extra={})=>({key,...extra});
+ assert.equal(editorShortcut(e('d',{metaKey:true})), 'duplicate');
+ assert.equal(editorShortcut(e('D',{ctrlKey:true})), 'duplicate');
+ assert.equal(editorShortcut(e('Delete')), 'delete');
+ assert.equal(editorShortcut(e('Backspace')), 'delete');
+ assert.equal(editorShortcut(e('z',{ctrlKey:true})), 'undo');
+ assert.equal(editorShortcut(e('z',{ctrlKey:true,shiftKey:true})), 'redo');
+ assert.equal(editorShortcut(e('y',{ctrlKey:true})), 'redo');
+ assert.equal(editorShortcut(e('z',{ctrlKey:true}),{editable:true}),null);
+ assert.equal(editorShortcut(e('d',{ctrlKey:true}),{modalOpen:true}),null);
+ assert.equal(editorShortcut(e('d',{ctrlKey:true}),{design:false}),null);
+ assert.equal(editorShortcut(e('Delete'),{design:false}),null);
+ assert.equal(editorShortcut(e('d',{ctrlKey:true}),{inside:false}),null);
+ assert.equal(editorShortcut(e('d',{ctrlKey:true,repeat:true})),null);
+ assert.equal(editorShortcut(e('z',{ctrlKey:true,altKey:true})),null);
+});
diff --git a/tools/check-export-structure.py b/tools/check-export-structure.py
new file mode 100644
index 0000000..9b70420
--- /dev/null
+++ b/tools/check-export-structure.py
@@ -0,0 +1,25 @@
+import zipfile, pathlib, re, sys
+p=pathlib.Path(sys.argv[1])
+with zipfile.ZipFile(p) as z:
+    names={x.filename for x in z.infolist() if not x.is_dir()}
+    assert z.testzip() is None
+    assert any(x.endswith('src/runtime/core/editor.js') for x in names)
+    assert 'src/runtime/core/index.js' in names
+    assert 'src/CustomerBrowser.tsx' in names
+    internal=0
+    for name in names:
+        if not name.startswith('src/') or not name.endswith(('.js','.jsx','.ts','.tsx')):
+            continue
+        data=z.read(name).decode()
+        for match in re.finditer(r'''(?:from\s*|import\s*)["'](\.{1,2}/[^"']+)["']''', data):
+            rel=match.group(1)
+            target=(pathlib.PurePosixPath(name).parent / rel)
+            parts=[]
+            for segment in target.parts:
+                if segment=='..':
+                    if parts:parts.pop()
+                elif segment!='.':parts.append(segment)
+            resolved='/'.join(parts)
+            assert resolved in names or any(resolved+ext in names for ext in ('.js','.jsx','.ts','.tsx')), (name,rel,resolved)
+            internal+=1
+    print(f'PASS: archive contains {len(names)} files; {internal} relative source imports resolved; ZIP CRC OK')