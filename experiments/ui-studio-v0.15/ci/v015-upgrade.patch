+/** Return the chain from the editable root to an item, including nodes in instance slots. */
+export function editorSelectionPath(root,id){
+  function visit(node,trail){
+    const current=[...trail,{id:node.id,name:node.name,kind:node.kind}];
+    if(node.id===id)return current;
+    for(const child of node.children||[]) {const found=visit(child,current);if(found)return found;}
+    for(const children of Object.values(node.slots||{}))for(const child of children){const found=visit(child,current);if(found)return found;}
+    return null;
+  }
+  return visit(root,[])||[];
+}
+/** Duplicate beside the selected node, retaining values but allocating fresh IDs for all descendants.
+ * Works in pages, definitions, and instance slot arrays; the source remains unchanged.
+ */
+export function duplicateEditorNode(doc,id,registry,pageId='main'){
+  const next=structuredClone(doc),source=locateNode(pageRoot(next,pageId),id);
+  if(!source?.parent)throw Error('루트는 복제할 수 없습니다');
+  const used=new Set();
+  const collect=n=>{used.add(n.id);for(const c of n.children||[])collect(c);for(const items of Object.values(n.slots||{}))for(const c of items)collect(c);};
+  for(const page of Object.values(next.pages))collect(page.root);
+  for(const definition of Object.values(next.definitions))collect(definition.root);
+  let cursor=1;
+  const nextId=()=>{while(used.has(`node_${cursor}`))cursor++;const candidate=`node_${cursor++}`;used.add(candidate);return candidate;};
+  const copied=structuredClone(source.node),remapped=new Map();
+  const assignIds=n=>{const old=n.id;n.id=nextId();remapped.set(old,n.id);for(const c of n.children||[])assignIds(c);for(const items of Object.values(n.slots||{}))for(const c of items)assignIds(c);};
+  assignIds(copied);
+  // Only remap references to nodes that were duplicated (never external targets).
+  const rewriteReferences=value=>{
+    if(!value||typeof value!=='object')return;
+    if(!Array.isArray(value)&&typeof value.nodeId==='string'&&remapped.has(value.nodeId))value.nodeId=remapped.get(value.nodeId);
+    for(const child of Object.values(value))rewriteReferences(child);
+  };
+  rewriteReferences(copied);
+  const fallback=source.node.kind==='component'?registry.get(source.node.typeId)?.displayName:source.node.kind==='instance'?source.node.definitionId:source.node.kind==='frame'?source.node.layout.type:'Element';
+  copied.name=`${copied.name||fallback||'Element'} Copy`;
+  const siblings=source.slotChildren||source.parent.children;
+  siblings.splice(source.index+1,0,copied);
+  touchDefinition(next,pageId);
+  return {document:validateDocument(next,registry),id:copied.id};
+}
