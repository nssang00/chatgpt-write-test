    "components": "node scripts/components.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "antd": "^5.27.0",
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@playwright/test": "^1.55.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
