# Run after installing Core SDK and setting up Python + .NET 8.
if(NOT DEFINED XYTRON OR NOT DEFINED SDK OR NOT DEFINED TEST_ROOT)
  message(FATAL_ERROR "XYTRON, SDK, TEST_ROOT required")
endif()
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}")
function(command project expected)
  execute_process(COMMAND "${XYTRON}" ${ARGN}
    WORKING_DIRECTORY "${TEST_ROOT}/${project}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT result EQUAL expected)
    message(FATAL_ERROR "${project}: ${ARGN}, wanted ${expected}, got ${result}: ${out} ${err}")
  endif()
endfunction()
foreach(backend cpp python csharp)
  execute_process(COMMAND "${XYTRON}" new desktop "${backend}_app" --backend "${backend}"
    WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE generated)
  if(NOT generated EQUAL 0)
    message(FATAL_ERROR "Failed to generate ${backend}")
  endif()
  command("${backend}_app" 1 test)
  command("${backend}_app" 1 build)
  command("${backend}_app" 1 doctor)
  command("${backend}_app" 1 restore --sdk "invalid&echo")
  command("${backend}_app" 0 restore --sdk "${SDK}")
  command("${backend}_app" 0 restore --sdk "${SDK}")
  command("${backend}_app" 0 build)
  command("${backend}_app" 0 test)
  command("${backend}_app" 0 doctor)
  command("${backend}_app" 2 run)
  command("${backend}_app" 1 publish)
  if(NOT EXISTS "${TEST_ROOT}/${backend}_app/.xytron/core.lock")
    message(FATAL_ERROR "Missing Core SDK lock for ${backend}")
  endif()
endforeach()
# Corrupt the lock, verify fail-closed, then explicitly remove/re-restore.
file(WRITE "${TEST_ROOT}/cpp_app/.xytron/core.lock" "tampered-lock\n")
command(cpp_app 1 build)
command(cpp_app 1 restore --sdk "${SDK}")
file(REMOVE "${TEST_ROOT}/cpp_app/.xytron/core.lock")
command(cpp_app 0 restore --sdk "${SDK}")
command(cpp_app 0 test)
# Linux-specific symlink attempts: a hostile local generated project must
# not redirect lock reads/writes or generated CMake files outside its tree.
if(CMAKE_HOST_UNIX)
  set(project_dir "${TEST_ROOT}/cpp_app")
  file(RENAME "${project_dir}/.xytron/core.lock" "${project_dir}/.xytron/lock.saved")
  file(CREATE_LINK "lock.saved" "${project_dir}/.xytron/core.lock"
    SYMBOLIC RESULT link_err)
  if(NOT link_err STREQUAL "0")
    message(FATAL_ERROR "Cannot set up lock symlink probe: ${link_err}")
  endif()
  command(cpp_app 1 build)
  command(cpp_app 1 restore --sdk "${SDK}")
  file(REMOVE "${project_dir}/.xytron/core.lock")
  file(RENAME "${project_dir}/.xytron/lock.saved" "${project_dir}/.xytron/core.lock")
  command(cpp_app 0 test)

  file(REMOVE "${project_dir}/.xytron/core.lock")
  file(WRITE "${project_dir}/.xytron/sentinel" "UNCHANGED")
  file(CREATE_LINK "sentinel" "${project_dir}/.xytron/core.lock.tmp"
    SYMBOLIC RESULT link_err)
  if(NOT link_err STREQUAL "0")
    message(FATAL_ERROR "Cannot set up temporary lock symlink probe")
  endif()
  command(cpp_app 1 restore --sdk "${SDK}")
  file(READ "${project_dir}/.xytron/sentinel" after)
  if(NOT after STREQUAL "UNCHANGED")
    message(FATAL_ERROR "CLI followed a staging symlink and damaged a file")
  endif()
  file(REMOVE "${project_dir}/.xytron/core.lock.tmp")
  command(cpp_app 0 restore --sdk "${SDK}")
  command(cpp_app 0 test)

  file(RENAME "${project_dir}/.xytron-build/source/CMakeLists.txt"
              "${project_dir}/.xytron-build/source/CMakeLists.saved")
  file(CREATE_LINK "CMakeLists.saved"
    "${project_dir}/.xytron-build/source/CMakeLists.txt"
    SYMBOLIC RESULT link_err)
  if(NOT link_err STREQUAL "0")
    message(FATAL_ERROR "Cannot set up generated CMake symlink probe")
  endif()
  command(cpp_app 1 build)
  file(REMOVE "${project_dir}/.xytron-build/source/CMakeLists.txt")
  file(RENAME "${project_dir}/.xytron-build/source/CMakeLists.saved"
              "${project_dir}/.xytron-build/source/CMakeLists.txt")
  command(cpp_app 0 build)
  command(cpp_app 0 test)
endif()
# Existing generated CMake manifest must never be truncated via a hard link.
# This negative probe is supported on Windows, Linux and macOS.
set(project_dir "${TEST_ROOT}/cpp_app")
set(source_dir "${project_dir}/.xytron-build/source")
file(REMOVE "${source_dir}/CMakeLists.txt")
file(WRITE "${source_dir}/guard-victim.txt" "SAFE_HARDLINK_VICTIM")
file(CREATE_LINK "${source_dir}/guard-victim.txt"
  "${source_dir}/CMakeLists.txt" RESULT link_err)
if(NOT link_err STREQUAL "0")
  message(FATAL_ERROR "Cannot create generated CMake hardlink probe: ${link_err}")
endif()
command(cpp_app 1 build)
file(READ "${source_dir}/guard-victim.txt" victim_after)
if(NOT victim_after STREQUAL "SAFE_HARDLINK_VICTIM")
  message(FATAL_ERROR "Generated CMake write truncated hardlinked victim")
endif()
file(REMOVE "${source_dir}/CMakeLists.txt")
command(cpp_app 0 build)
command(cpp_app 0 test)
file(READ "${TEST_ROOT}/python_app/xytron.json" manifest)
string(REPLACE "\"mode\":\"desktop\"" "\"mode\":\"web\"" malicious "${manifest}")
file(WRITE "${TEST_ROOT}/python_app/xytron.json" "${malicious}")
command(python_app 1 build)
file(WRITE "${TEST_ROOT}/python_app/xytron.json" "${manifest}")
command(python_app 0 test)
message(STATUS "Xytron offline Core restore and three-language backend-only workflow PASS")
