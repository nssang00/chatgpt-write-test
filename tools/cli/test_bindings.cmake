# Test trusted on-device introspection and generated JS/TS artifacts.
if(NOT XYTRON OR NOT CPP_PLUGIN OR NOT LEGACY_PLUGIN OR NOT ROOT)
  message(FATAL_ERROR "Missing required bindgen test argument")
endif()
file(REMOVE_RECURSE "${ROOT}")
file(MAKE_DIRECTORY "${ROOT}")
file(WRITE "${ROOT}/plugin.json" "{\"schemaVersion\":1,\"name\":\"cppsample\",\"version\":\"2.0.0\",\"runtime\":\"native\",\"entry\":{\"win-x64\":\"bin/win-x64/cppsample.dll\",\"linux-x64\":\"bin/linux-x64/libcppsample.so\"}}\n")
execute_process(COMMAND "${XYTRON}" bindings generate --library "${CPP_PLUGIN}" --out bindings --trusted
  WORKING_DIRECTORY "${ROOT}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE err)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Bindgen failed: ${output} ${err}")
endif()
foreach(f exports.json index.mjs index.d.ts)
  if(NOT EXISTS "${ROOT}/bindings/${f}")
    message(FATAL_ERROR "Missing bindgen output: ${f}")
  endif()
endforeach()
file(READ "${ROOT}/bindings/index.d.ts" decl)
foreach(pattern "add(arg0: number, arg1: number): Promise<number>" "echo(arg0: string): Promise<string>" "binary_size(arg0: Uint8Array): Promise<number>")
  string(FIND "${decl}" "${pattern}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "Missing typed declaration: ${pattern}")
  endif()
endforeach()
file(READ "${ROOT}/bindings/index.mjs" js)
string(FIND "${js}" "bridge.invoke(\"cppsample.add\", ...args)" pos)
if(pos EQUAL -1)
  message(FATAL_ERROR "Incorrect JS bridge dispatch")
endif()
execute_process(COMMAND "${XYTRON}" bindings generate --library "${CPP_PLUGIN}" --out bindings --trusted
  WORKING_DIRECTORY "${ROOT}" RESULT_VARIABLE duplicate)
if(duplicate EQUAL 0)
  message(FATAL_ERROR "Bindings must refuse overwrites")
endif()
execute_process(COMMAND "${XYTRON}" bindings generate --library "${CPP_PLUGIN}" --out ignored
  WORKING_DIRECTORY "${ROOT}" RESULT_VARIABLE untrusted)
if(untrusted EQUAL 0)
  message(FATAL_ERROR "Bindings without --trusted must fail")
endif()
file(WRITE "${ROOT}/plugin.json" "{\"schemaVersion\":1,\"name\":\"sample\",\"version\":\"1.0.0\",\"runtime\":\"native\",\"entry\":{\"win-x64\":\"bin/win-x64/sample.dll\",\"linux-x64\":\"bin/linux-x64/libsample.so\"}}\n")
execute_process(COMMAND "${XYTRON}" bindings generate --library "${LEGACY_PLUGIN}" --out legacy --trusted
  WORKING_DIRECTORY "${ROOT}" RESULT_VARIABLE legacy)
if(legacy EQUAL 0)
  message(FATAL_ERROR "Legacy/untyped plugin must fail closed")
endif()
message(STATUS "S2 C++ typed-bindings and rejection scenarios PASS")
