# Offline C++/Python/C# project manifest and module validation contract.
# No browser engine, network, user-created process or hardware is used.
if(NOT DEFINED XYTRON OR NOT DEFINED TEST_ROOT)
  message(FATAL_ERROR "XYTRON and TEST_ROOT required")
endif()
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}")
function(expect project wanted)
  execute_process(COMMAND "${XYTRON}" ${ARGN}
    WORKING_DIRECTORY "${TEST_ROOT}/${project}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(wanted STREQUAL "ok" AND NOT rc EQUAL 0)
    message(FATAL_ERROR "Expected success: ${project} ${ARGN}: ${rc} ${err}")
  endif()
  if(wanted STREQUAL "fail" AND rc EQUAL 0)
    message(FATAL_ERROR "Expected denial: ${project} ${ARGN}: ${out}")
  endif()
endfunction()
foreach(lang cpp python csharp)
  execute_process(COMMAND "${XYTRON}" new desktop "${lang}_app" --backend "${lang}"
    WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Scaffold ${lang} failed: ${err}")
  endif()
  expect("${lang}_app" ok validate)
endforeach()
expect(cpp_app ok module add utilities --language python)
expect(cpp_app ok module add audits --language csharp)
expect(cpp_app ok validate)
expect(cpp_app fail module add utilities --language csharp)

set(project_dir "${TEST_ROOT}/cpp_app")
file(READ "${project_dir}/xytron.json" original)
function(replace_manifest needle replacement)
  string(REPLACE "${needle}" "${replacement}" patched "${original}")
  if(patched STREQUAL original)
    message(FATAL_ERROR "Manifest mutation did not apply: ${needle}")
  endif()
  file(WRITE "${project_dir}/xytron.json" "${patched}")
  expect(cpp_app fail validate)
  file(WRITE "${project_dir}/xytron.json" "${original}")
  expect(cpp_app ok validate)
endfunction()
replace_manifest("\"schemaVersion\": 1" "\"schemaVersion\": 2")
replace_manifest("\"mode\":\"desktop\"" "\"mode\":\"web\"")
replace_manifest("\"engine\":\"auto\"" "\"engine\":\"unknown\"")
replace_manifest("\"entry\":\"app://desktop/index.html\"" "\"entry\":\"https://remote.invalid/\"")
replace_manifest("\"language\": \"cpp\"" "\"language\": \"unknown\"")
replace_manifest("\"path\":\"modules/utilities\"" "\"path\":\"../unsafe\"")
replace_manifest("\"id\":\"utilities\"" "\"id\":\"app\"")

file(RENAME "${project_dir}/ui/index.html" "${project_dir}/ui/index.backup")
expect(cpp_app fail validate)
file(RENAME "${project_dir}/ui/index.backup" "${project_dir}/ui/index.html")
expect(cpp_app ok validate)
file(READ "${project_dir}/modules/utilities/module.json" mod_meta)
string(REPLACE "\"role\":\"feature\"" "\"role\":\"main\"" bad_meta "${mod_meta}")
file(WRITE "${project_dir}/modules/utilities/module.json" "${bad_meta}")
expect(cpp_app fail validate)
file(WRITE "${project_dir}/modules/utilities/module.json" "${mod_meta}")
expect(cpp_app ok validate)
if(CMAKE_HOST_UNIX)
  file(RENAME "${project_dir}/backend/main.cpp" "${project_dir}/backend/main.original.cpp")
  file(CREATE_LINK "main.original.cpp" "${project_dir}/backend/main.cpp" SYMBOLIC RESULT err)
  if(NOT err STREQUAL "0")
    message(FATAL_ERROR "Cannot create symlink fixture: ${err}")
  endif()
  expect(cpp_app fail validate)
  file(REMOVE "${project_dir}/backend/main.cpp")
  file(RENAME "${project_dir}/backend/main.original.cpp" "${project_dir}/backend/main.cpp")
  expect(cpp_app ok validate)
endif()
message(STATUS "CLI offline manifest and mixed-language module declaration PASS")
